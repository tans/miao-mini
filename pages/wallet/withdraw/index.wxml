<view class="withdraw-container">
  <!-- 可提现余额 -->
  <view class="balance-section">
    <view class="balance-bg">
      <view class="balance-main">
        <text class="balance-label">可提现金额(元)</text>
        <view class="balance-amount-row">
          <text class="balance-yuan">¥</text>
          <text class="balance-value">{{withdrawableAmount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 实名认证提示 -->
  <view class="verify-tip" wx:if="{{!realNameVerified}}">
    <text class="tip-icon">!</text>
    <text class="tip-text">首次提现需要先完成实名认证</text>
  </view>

  <view class="verify-tip" wx:if="{{withdrawAuthorization && withdrawAuthorization.state !== 'TAKING_EFFECT'}}">
    <text class="tip-icon">!</text>
    <text class="tip-text">请先完成微信提现免确认收款授权</text>
  </view>

  <!-- 提现金额输入 -->
  <view class="amount-section">
    <view class="section-title">提现金额</view>
    <view class="input-wrapper">
      <text class="input-yuan">¥</text>
      <input
        type="digit"
        class="input-field"
        placeholder="请输入提现金额"
        value="{{amount}}"
        bindinput="onAmountInput"
      />
    </view>
    <view class="all-amount-btn" bindtap="handleAllAmount">
      <text class="all-amount-text">全部提现</text>
    </view>
    <view class="withdraw-threshold-tip">
      <text class="withdraw-threshold-text">可提现金额满{{minWithdrawAmount}}元才可提现</text>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="error-tip" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
  </view>

  <!-- 确认提现按钮 -->
  <view class="submit-section">
    <button class="submit-btn {{loading || authorizing ? 'loading' : ''}}" bindtap="handleWithdraw" disabled="{{loading || authorizing}}">
      <text wx:if="{{!loading}}">确认提现</text>
      <text wx:if="{{loading}}">提交中...</text>
      <text wx:if="{{!loading && authorizing}}">授权中...</text>
    </button>
  </view>

  <!-- 注意事项 -->
  <view class="notice-section">
    <view class="notice-title">提现说明</view>
    <view class="notice-item">• 可提现金额满{{minWithdrawAmount}}元才可发起提现</view>
    <view class="notice-item">• 提现前需先在微信中完成收款授权</view>
    <view class="notice-item">• 提现申请提交后，预计1到3个工作日到账</view>
    <view class="notice-item">• 如有疑问请联系客服</view>
  </view>
</view>
