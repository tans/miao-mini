<view class="profile-container">
  <!-- 头像卡片 -->
  <view class="avatar-card">
    <view class="avatar-section">
      <image class="avatar" src="{{avatarSrc}}" mode="aspectFill" binderror="onAvatarError" />
      <view class="avatar-edit" bindtap="changeAvatar">
        <text class="avatar-edit-text">更换头像</text>
      </view>
    </view>
  </view>

  <!-- 信息卡片 -->
  <view class="info-card">
    <view class="info-row info-row-muted">
      <text class="info-label">用户ID</text>
      <text class="info-value info-value-muted">{{userIdDisplay}}</text>
      <view class="info-copy-btn info-copy-btn-muted" bindtap="copyUserId">复制</view>
    </view>
    <view class="info-row">
      <text class="info-label">昵称</text>
      <input
        class="info-input"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        type="nickname"
        placeholder="请输入昵称"
        placeholder-class="info-placeholder"
      />
    </view>
    <view class="info-row">
      <text class="info-label">联系电话</text>
      <view class="phone-field">
        <input
          class="info-input"
          value="{{phone}}"
          bindinput="onPhoneInput"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="info-placeholder"
        />
        <button
          class="phone-bind-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
          loading="{{bindingPhone}}"
          disabled="{{bindingPhone}}"
        >
          一键验证
        </button>
      </view>
    </view>
    <view class="phone-hint">支持微信手机号快速验证，也可手动填写后保存。</view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <view class="save-btn" bindtap="saveProfile">保存修改</view>
  </view>
</view>
